{
  "name": "claude-studio",
  "version": "0.1.0",
  "description": "Desktop UI for running Claude Code sessions in parallel: projects, git worktrees, diffs, terminals",
  "main": "out/main/index.js",
  "license": "MIT",
  "author": "bv",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "ELECTRON_DISABLE_SANDBOX=1 electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "smoke": "npm run build:light && CS_SMOKE=1 ELECTRON_DISABLE_SANDBOX=1 taskset -c 0-2 nice -n 15 electron .",
    "dist": "npm run build && electron-builder",
    "build:light": "taskset -c 0-3 nice -n 15 env GOMAXPROCS=2 electron-vite build",
    "start:built": "ELECTRON_DISABLE_SANDBOX=1 electron ."
  },
  "build": {
    "appId": "dev.bv.claude-studio",
    "productName": "Claude Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "resources/icon.png"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
